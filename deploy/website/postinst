#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Pool sizing drop-in for whatever PHP version(s) are installed; the
    # path is version-dependent, so it is placed at install time.
    for pooldir in /etc/php/*/fpm/pool.d; do
        [ -d "$pooldir" ] && cp /usr/share/radio-website/zz-radio-pool.conf "$pooldir/zz-radio.conf"
    done

    # lighty-enable-mod exits non-zero for already-enabled mods.
    lighty-enable-mod fastcgi fastcgi-php-fpm radio >/dev/null 2>&1 || true

    systemctl restart 'php*-fpm.service' >/dev/null 2>&1 || true
    systemctl restart lighttpd >/dev/null 2>&1 || true
fi
