# Configuration for radiod. Commented-out entries show the defaults.

# The ALSA output device. Find yours with `aplay -l`; the plughw prefix
# lets ALSA convert sample rates/formats the hardware does not support.
audio_device = "plughw:0,0"

# Where the built-in website (and JSON API) listens. Port 80 keeps the
# origin of installed home-screen PWAs (http://<host>/) working; the
# systemd unit grants the port-80 capability. Use a loopback address if
# the radio should not be reachable from the LAN.
listen = "0.0.0.0:80"

# The first-boot volume (0-100). Once running, the radio remembers its
# volume across restarts, reboots and reinstalls (state.toml in the
# systemd state directory); this value only applies when no saved state
# exists.
#initial_volume = 50
#state_path = "/var/lib/radiod/state.toml"

# Forward FFmpeg's own log lines (reconnect chatter, stream warnings) to
# the journal, prefixed "radiod: ffmpeg:" and rate limited — a diagnostic
# aid when hunting streaming stalls, alongside the always-on /debug
# endpoint. The --debug flag does the same without touching this file
# (`systemctl edit radiod`, add --debug to ExecStart).
#debug = false

# The hardware output ceiling — the speaker protection. radiod sets this
# mixer control to the ceiling at startup and re-asserts it whenever
# playback (re)starts, so alsamixer, a boot-time `alsactl restore`, or a
# re-enumerating USB DAC cannot leave the output loud. The digital path
# runs at full scale; the ceiling is the loudest the speakers can get.
#
# Required when playing through ALSA. Discover control names with
# `amixer -c<card> scontrols`. Prefer ceiling_db (0 = full scale,
# negative = quieter); use ceiling_percent only for controls without dB
# info (the raw scale may be nonlinear).
[mixer]
control = "PCM"
ceiling_db = -12.0
#device = "hw:0"        # derived from audio_device when omitted
#ceiling_percent = 40   # instead of ceiling_db, never both

# The embedded AirPlay 2 receiver: pick this device from any Apple
# device's AirPlay list. An AirPlay session preempts the radio (the
# station resumes afterwards when resume_radio is on); the sender's
# volume slider only ever attenuates, and the mixer ceiling above caps
# everything in hardware. Needs the avahi-daemon service for discovery;
# without it, radiod logs a warning and runs radio-only. The values
# shown are the defaults.
#[airplay]
#enabled = true
#name = "Radio"          # the name in the AirPlay picker
#port = 7000
#resume_radio = true
# The receiver identity (keypair, created on first run) — senders
# remember this receiver by it. The default lives in the systemd
# StateDirectory and survives upgrades; only change it if you know why.
#identity_path = "/var/lib/radiod/airplay-identity"
